{
  "name": "screenshot-to-code",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "build": "pnpm -C frontend build",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "pnpm -C frontend test",
    "test:backend": "cd backend && poetry run pytest"
  },
  "dependencies": {
    "@prisma/client": "^5.8.0"
  },
  "devDependencies": {
    "prisma": "^5.8.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "pnpm@10.32.1"
}
